rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Open workspace)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Clients Collection (Open access)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Files Collection (Open access)
    match /files/{fileId} {
      allow read, write: if true;
    }
  }
}
